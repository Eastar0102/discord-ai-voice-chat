# Copy to .env and fill in what you use. Only DISCORD_TOKEN is required.
DISCORD_TOKEN=

# LLM providers (only for the ones you select in config/config.json)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Docs co-reading (optional — see scripts/google_login.py)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional overrides
# API_BASE_URL=http://localhost:8000
# CONTROL_PORT=
# AUDIO_INPUT_DEVICE=
# AUDIO_OUTPUT_DEVICE=
